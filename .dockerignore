# Git files
.git
.gitignore

# Node modules
node_modules

# Build artifacts (if building outside Docker first)
dist 
# Keep dist if using multi-stage build where source is copied first

# Source files are needed for the build step inside Docker
# src

# Test files
tests/
*.test.ts
*.spec.ts
vitest.config.ts
jest.config.js

# Configuration files
# tsconfig.json is needed for the build step inside Docker
# tsconfig.json
.env*
# pnpm-lock.yaml and pnpm-workspace.yaml are required by the Docker build
# (pnpm install --frozen-lockfile), so they must NOT be ignored here.
package-lock.json
yarn.lock
.clinerules

# Docker files themselves
Dockerfile
docker-compose.yml

# Other development files
README.md
LICENSE
.npmignore
